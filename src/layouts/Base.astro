---
import '../styles/global.css';
import { ui, href, contact } from '../data/site';
import { projects, type Lang } from '../data/projects';
import { getImage } from 'astro:assets';

interface Props { lang: Lang; title?: string; description?: string; alt: string; current?: 'work' | 'studio' | 'about' | 'contact'; preload?: string; }
const { lang, title, description, alt, current, preload } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.title}` : t.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(alt, Astro.site);
const en = lang === 'en';
const menu = await Promise.all(projects.map(async (p, i) => ({
  n: String(i + 1).padStart(2, '0'), name: p.name, meta: `${p.type[lang]}, ${p.location[lang]}`, href: href(lang, `#${p.slug}`),
  img: (await getImage({ src: p.hero.src, width: 1200, format: 'webp' })).src, thumb: (await getImage({ src: p.hero.src, width: 160, format: 'webp' })).src,
})));
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description ?? t.desc} />
  <meta name="theme-color" content="#0b0d13" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang === 'en' ? 'mk' : 'en'} href={altUrl} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description ?? t.desc} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-head" data-head>
    <a class="wordmark" href={href(lang)}>Iva Hristova</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu><span class="mb-open">{en ? 'Menu' : 'Мени'}</span><span class="mb-close">{en ? 'Close' : 'Затвори'}</span></button>
  </header>
  <nav class="fm" id="site-nav" aria-label={en ? 'Main' : 'Главна'} data-fm>
    <div class="fm-view" aria-hidden="true">
      {menu.map((m, i) => <img src={m.img} alt="" loading="lazy" decoding="async" class={i === 0 ? 'on' : undefined} />)}
      <p class="mono fm-tag">{en ? 'Her render' : 'Нејзин рендер'}</p>
    </div>
    <div class="fm-col">
      <p class="mono fm-k">{en ? 'Projects' : 'Проекти'}</p>
      <ol class="fm-list">
        {menu.map((m, i) => (
          <li style={`--i:${i}`}><a href={m.href} data-i={i}>
            <img class="fm-thumb" src={m.thumb} alt="" loading="lazy" />
            <span class="mono fm-n">{m.n}</span><span class="fm-name">{m.name}</span><span class="fm-meta">{m.meta}</span>
          </a></li>
        ))}
      </ol>
      <ul class="fm-sub" style={`--i:${menu.length}`}>
        <li><a href={href(lang, '#iva')}>{en ? 'About Iva' : 'За Ива'}</a></li>
        <li><a href={href(lang, '#studio')}>Hristdesign</a></li>
        <li><a href={href(lang, 'work/')} aria-current={current === 'work' ? 'page' : undefined}>{t.nav.work}</a></li>
        <li><a href={href(lang, 'contact/')} aria-current={current === 'contact' ? 'page' : undefined}>{t.nav.contact}</a></li>
        <li><a class="lang-switch" href={alt} hreflang={en ? 'mk' : 'en'} lang={en ? 'mk' : 'en'}><span aria-hidden="true">{t.other}</span><span class="sr">{t.otherLabel}</span></a></li>
      </ul>
      <p class="mono fm-mail" style={`--i:${menu.length + 1}`}><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>
  </nav>

  <main id="main"><slot /></main>

  <footer class="site-foot wrap">
    <div class="foot-grid">
      <p class="foot-big">{t.talk}</p>
      <ul class="foot-list">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
        <li><a href={`https://instagram.com/${contact.instagram}`} rel="noopener">Instagram @{contact.instagram}</a></li>
      </ul>
      <ul class="foot-list">
        <li><a href={href(lang, 'work/')}>{t.nav.work}</a></li>
        <li><a href={href(lang, 'about/')}>{t.nav.about}</a></li>
        <li><a href={href(lang, 'contact/')}>{t.nav.contact}</a></li>
      </ul>
    </div>
    <p class="foot-ghost" aria-hidden="true">Iva Hristova</p>
    <div class="foot-legal"><span>© {new Date().getFullYear()} Iva Hristova · Hristdesign</span><span>{lang === 'en' ? 'Skopje, North Macedonia' : 'Скопје, Северна Македонија'}</span></div>
  </footer>

  <script>
    import { whenIdle } from '../scripts/idle';
    whenIdle(() => import('../scripts/scroll').then((m) => m.initScroll()));

    const head = document.querySelector<HTMLElement>('[data-head]')!;
    const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
    const nav = document.querySelector<HTMLElement>('[data-fm]')!;
    const imgs = [...nav.querySelectorAll<HTMLImageElement>('.fm-view img')];
    const setMenu = (open: boolean) => {
      nav.classList.toggle('open', open); head.classList.toggle('menu-open', open); document.documentElement.classList.toggle('menu-on', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) nav.querySelector<HTMLElement>('.fm-list a')?.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => setMenu(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
    const show = (e: Event) => { const i = (e.target as HTMLElement).closest<HTMLElement>('[data-i]')?.dataset.i; if (i != null) imgs.forEach((im, k) => im.classList.toggle('on', k === +i)); };
    nav.addEventListener('pointerover', show); nav.addEventListener('focusin', show);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) { setMenu(false); btn.focus(); } });

    let last = 0;
    const onScroll = () => {
      const y = window.scrollY;
      head.classList.toggle('solid', y > 40);
      last = y;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</body>
</html>
