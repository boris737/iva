---
// Home, rebuilt in scroll-craft style. See scrollcraft/builds/iva/BRIEF.md for the journey,
// feeling curve and score. Every building on this page is Iva's; generated media is
// limited to the empty park plates (day/night), material samples and a motion study of her render.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ui, href, contact } from '../data/site';
import { projects, type Lang } from '../data/projects';
import plate from '../assets/hero/plate.png';
import plateNight from '../assets/hero/plate-night.png';
import building from '../assets/hero/building.png';
import fg from '../assets/hero/fg.png';
import plan from '../assets/work/aura-plan-ground.png';
import planLines from '../assets/work/aura-plan-lines.png';
import axo from '../assets/work/aura-axo.png';
import mark from '../assets/hrist-mark-charcoal.png';
import walnut from '../assets/tex/walnut.png';
import travertine from '../assets/tex/travertine.png';
import concrete from '../assets/tex/concrete.png';
import plaster from '../assets/tex/olive-plaster.png';
import signature from '../assets/signature.svg?raw';
import portrait from '../assets/portrait.png';
import ivaLogo from '../assets/iva-logo-white.png';
import hristLogo from '../assets/hrist-logo-white.png';
import ChapterBar from '../components/ChapterBar.astro';
import { about } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const t = ui[lang];

const L = async (src: any, width: number) => (await getImage({ src, format: 'webp', width })).src;
const W3 = [900, 1600, 2346];
const hero = {
  plate: await Promise.all(W3.map((w) => L(plate, w))),
  building: await Promise.all(W3.map((w) => L(building, w))),
  fg: await Promise.all(W3.map((w) => L(fg, w))),
  night: await Promise.all(W3.map((w) => L(plateNight, w))),
};
const set = (a: string[]) => a.map((u, i) => `${u} ${W3[i]}w`).join(', ');
const planUrl = await L(planLines, 1300);
const wood = await L(walnut, 1400);

const sail = projects.find((p) => p.slug === 'quiet-sailing')!;
const pick = ['sail-sketch-fish', 'sail-boats', 'sail-sketch-museum', 'sail-fire'];
const sailTrack = [sail.hero, ...pick.map((n) => sail.gallery.find((g) => g.src.src.includes(n))!).filter(Boolean)];
const rigour = ['xmall', 'health-center', 'public-building'].map((s) => projects.find((p) => p.slug === s)!);
// the drawing each render is plotted over, and how wide it may sit on the sheet (≤1.6× its native width)
const sheetDraw: Record<string, string> = { 'xmall': 'xmall-axo', 'health-center': 'health-axo', 'public-building': 'public-section' };
const drawOf = (p: (typeof projects)[number]) => p.gallery.find((g) => g.src.src.includes(sheetDraw[p.slug]))!;
const peakLines = en
  ? ['Inside, it starts as a line.', 'Then it stands up.', 'Then the ring closes.']
  : ['Внатре, почнува како линија.', 'Потоа се исправа.', 'Потоа прстенот се затвора.'];
const mats = [walnut, travertine, concrete, plaster];
---
<Base lang={lang} alt={en ? '/mk/' : '/'}>

  <!-- 1 · Arrival: four planes, her name between the land and her building -->
  <section class="hero" data-hero data-chapter={en ? "Aura Theatre" : "Театар Аура"} aria-label={en ? 'Iva Hristova, architect' : 'Ива Христова, архитект'}>
    <div class="planes" aria-hidden="true">
      <img class="pl sky" srcset={set(hero.plate)} sizes="120vw" alt="" fetchpriority="high" />
      <img class="pl land" srcset={set(hero.plate)} sizes="120vw" alt="" />
      <p class="pl name">{en ? <>Iva<br />Hristova</> : <>Ива<br />Христова</>}</p>
      <img class="pl bldg" srcset={set(hero.building)} sizes="120vw" alt="" fetchpriority="high" />
      <img class="pl fgl" srcset={set(hero.fg)} sizes="120vw" alt="" />
      <div class="pl haze"></div>
    </div>
    <h1 class="sr">{en ? 'Iva Hristova, architect and interior designer' : 'Ива Христова, архитект и дизајнер на ентериер'}</h1>
    <div class="hero-foot">
      <p>{en ? 'Architect and interior designer. Skopje.' : 'Архитект и дизајнер на ентериер. Скопје.'}</p>
      <p class="hero-cap">{en ? 'Aura Theatre, her design. The empty park behind it is a generated plate.' : 'Театар Аура, нејзин проект. Празниот парк зад него е генерирана подлога.'}</p>
    </div>
  </section>

  <!-- 2 · Approach: the camera comes down to her entrance under the reader's hand, then the glass doors part -->
  <section class="approach" data-approach aria-labelledby="ap-t">
    <div class="ap-stage">
      <picture class="ap-still">
        <source media="(max-width: 760px)" srcset="/seq/door/m/59.webp" />
        <img src="/seq/door/d/59.webp" alt={en ? 'The glass entrance of Aura Theatre at dusk, lobby and stair lit inside' : 'Стаклениот влез на Театар Аура во самрак, осветлено фоаје и скали'} loading="lazy" />
      </picture>
      <canvas class="ap-seq" aria-hidden="true"></canvas>
      <div class="ap-door ap-l" aria-hidden="true"></div>
      <div class="ap-door ap-r" aria-hidden="true"></div>
      <div class="ap-copy">
        <h2 class="display" id="ap-t"><span>Aura Theatre</span></h2>
        <p class="ap-line ap-1">{en ? 'A theatre in a park in Aerodrom, Skopje.' : 'Театар во парк во Аеродром, Скопје.'}</p>
        <p class="ap-line ap-2">{en ? 'Walk up to the glass.' : 'Пријди до стаклото.'}</p>
        <p class="ap-line ap-3">{en ? 'Come in.' : 'Влези.'}</p>
      </div>
      <p class="ap-note">{en ? 'Camera move animated from her render with Higgsfield.' : 'Движењето на камерата е анимирано од нејзиниот рендер со Higgsfield.'}</p>
    </div>
  </section>

  <!-- 3 · Peak: the plan rises into the building, then the building lights up -->
  <section class="peak" data-peak data-plan={planUrl} aria-labelledby="peak-t">
    <div class="peak-stage">
      <div class="peak-static">
        <figure><Image src={plan} format="webp" width={650} alt={en ? 'Aura Theatre ground floor plan' : 'Основа на приземје, Театар Аура'} /><figcaption>{peakLines[0]}</figcaption></figure>
        <figure><Image src={axo} format="webp" width={277} alt={en ? 'Aura Theatre axonometry' : 'Аксонометрија, Театар Аура'} /><figcaption>{peakLines[1]}</figcaption></figure>
      </div>
      <canvas class="peak-3d" aria-hidden="true"></canvas>
      <ol class="peak-lines" aria-hidden="true">{peakLines.map((l) => <li class="display">{l}</li>)}</ol>
      <div class="peak-title">
        <h2 class="display" id="peak-t">Aura Theatre</h2>
        <p class="small">{en ? 'Theatre and cultural centre, Aerodrom, Skopje.' : 'Театар и културен центар, Аеродром, Скопје.'} <a class="link" href={href(lang, 'work/aura-theatre/')}>{en ? 'Open the project' : 'Отвори го проектот'}</a></p>
        <p class="peak-note">{en ? 'Plan: Iva Hristova. 3D massing simplified from her ground floor plan. Drag to turn it.' : 'Основа: Ива Христова. 3Д волумените се поедноставени од нејзината основа. Повлечи за да го свртиш.'}</p>
      </div>
    </div>
  </section>

  <!-- 3b · Iva: who drew all this -->
  <section class="iva" data-iva data-chapter="Iva" aria-labelledby="iva-t">
    <Image class="iva-mark" src={ivaLogo} format="webp" width={1400} alt="" aria-hidden="true" loading="lazy" />
    <div class="iva-in wrap">
      <figure class="iva-photo">
        <Image src={portrait} format="webp" widths={[320, 538]} sizes="(max-width: 760px) 70vw, 30vw" alt={en ? 'Portrait of Iva Hristova' : 'Портрет на Ива Христова'} loading="lazy" />
      </figure>
      <div class="iva-copy">
        <p class="small iva-kicker">{en ? 'Who drew this' : 'Кој го нацрта ова'}</p>
        <h2 class="display" id="iva-t">{en ? 'Iva Hristova' : 'Ива Христова'}</h2>
        <p class="iva-lead">{about[lang].bio[0]}</p>
        <p class="iva-body">{about[lang].bio[1]}</p>
        <ul class="iva-roles">
          <li><span>{en ? 'Now' : 'Сега'}</span>{en ? 'Interior designer, Parallel Group, Skopje' : 'Дизајнер на ентериер, Parallel Group, Скопје'}</li>
          <li><span>{en ? 'Studio' : 'Студио'}</span>{en ? 'Founder, Hristdesign' : 'Основач, Hristdesign'}</li>
        </ul>
        <a class="link" href={href(lang, 'about/')}>{en ? 'More about her' : 'Повеќе за неа'}</a>
      </div>
    </div>
  </section>

  <!-- 4 · Hand: Quiet Sailing travels sideways, sketches as large as the renders -->
  <section class="hand on-light" data-hand data-chapter="Quiet Sailing" aria-labelledby="hand-t">
    <div class="hand-stage">
      <header class="hand-head">
        <h2 class="display" id="hand-t">Quiet Sailing</h2>
        <p class="small muted">{sail.summary[lang]}</p>
        <a class="link small" href={href(lang, 'work/quiet-sailing/')}>{en ? 'Open the project' : 'Отвори го проектот'}</a>
      </header>
      <ul class="hand-track">
        {sailTrack.map((s, i) => (
          <li class:list={[s.kind, i % 3 === 1 && 'low']}>
            <Image src={s.src} format="webp" widths={[480, s.src.width]} sizes="(max-width: 760px) 90vw, 70vw" alt={s.alt[lang]} loading="lazy" style={`--hmax:${Math.round(s.src.height * 1.6)}px`} />
            <span>{s.kind === 'sketch' ? (en ? 'Hand sketch' : 'Скица') : s.kind === 'render' ? (en ? 'Render' : 'Рендер') : (en ? 'Drawing' : 'Цртеж')}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 · Rigour: a drafting table. Each project arrives as her drawing; a plotter line prints her render over it -->
  <section class="rigour" data-rigour data-chapter={en ? "Drawings" : "Цртежи"} aria-label={en ? 'More projects' : 'Повеќе проекти'}>
    <div class="rg-stage">
      <p class="rg-kicker small">{en ? 'Three more, drawn before they were rendered' : 'Уште три, нацртани пред да бидат рендерирани'}</p>
      {rigour.map((p, i) => { const d = drawOf(p); return (
        <article class:list={['rg', `rg-${i}`]} data-rg>
          <div class="rg-text">
            <h3 class="display"><a href={href(lang, `work/${p.slug}/`)}>{p.name}</a></h3>
            <p class="small rg-meta">{p.type[lang]}, {p.location[lang]}{p.year ? `, ${p.year}` : ''}</p>
            <p class="rg-sum">{p.summary[lang]}</p>
            <a class="link small" href={href(lang, `work/${p.slug}/`)} tabindex="-1" aria-hidden="true">{en ? 'Open the project' : 'Отвори го проектот'}</a>
          </div>
          <a class="rg-sheet" href={href(lang, `work/${p.slug}/`)} tabindex="-1" aria-hidden="true">
            <div class="rg-paper">
              <Image class="rg-draw" src={d.src} format="webp" width={d.src.width} alt="" loading="lazy" style={`--dw:${Math.round(d.src.width * 1.5)}px`} />
              <p class="rg-block"><span>{p.name}</span><span>{p.location[lang]}</span><span>I. Hristova</span></p>
            </div>
            <div class="rg-photo"><Image src={p.hero.src} format="webp" widths={[480, p.hero.src.width]} sizes="(max-width: 760px) 92vw, 60vw" alt={p.hero.alt[lang]} loading="lazy" /></div>
            <span class="rg-scan" aria-hidden="true"></span>
            <span class="rg-shade" aria-hidden="true"></span>
          </a>
        </article>
      ); })}
    </div>
    <p class="wrap all"><a class="link" href={href(lang, 'work/')}>{en ? 'All five projects' : 'Сите пет проекти'}</a></p>
  </section>

  <!-- 6 · Touch: Hristdesign, a lamp you move across her materials -->
  <section class="touch" id="studio" data-touch data-chapter="Hristdesign" style={`--wood:url(${wood})`} aria-labelledby="touch-t">
    <div class="touch-lamp" aria-hidden="true"></div>
    <Image class="touch-wm" src={hristLogo} format="webp" width={1200} alt="" aria-hidden="true" loading="lazy" />
    <div class="touch-in wrap">
      <div class="touch-copy">
        <Image class="touch-mark" src={mark} width={150} alt="Hristdesign" loading="lazy" />
        <h2 class="display" id="touch-t">{en ? 'Rooms, too.' : 'И простории.'}</h2>
        <p class="lede">{t.studioText}</p>
        <a class="btn" href={href(lang, 'contact/')}>{t.studioCta}</a>
      </div>
      <ul class="touch-mats">
        {mats.map((m, i) => (
          <li><Image src={m} format="webp" width={420} height={560} alt="" loading="lazy" style={i === 3 ? 'filter:saturate(.45) brightness(.85)' : undefined} /><span>{t.mat[i]}</span></li>
        ))}
      </ul>
      <p class="touch-note small">{en ? 'Material textures are generated samples, not her projects.' : 'Текстурите на материјалите се генерирани примероци, не нејзини проекти.'}</p>
    </div>
  </section>

  <!-- 7 · Close: the same park after dark, her building still lit, her signature -->
  <section class="close" data-close data-chapter={en ? "Contact" : "Контакт"} aria-labelledby="close-t">
    <div class="planes" aria-hidden="true">
      <img class="pl land" srcset={set(hero.night)} sizes="110vw" alt="" loading="lazy" />
      <img class="pl bldg" srcset={set(hero.building)} sizes="110vw" alt="" loading="lazy" />
      <img class="pl fgl" srcset={set(hero.fg)} sizes="110vw" alt="" loading="lazy" />
      <div class="pl night"></div>
    </div>
    <div class="close-in wrap">
      <div class="sig" set:html={signature} role="img" aria-label={en ? 'Signature: Iva Hristova' : 'Потпис: Ива Христова'}></div>
      <h2 class="display" id="close-t">{en ? 'Let’s build something.' : 'Ајде да изградиме нешто.'}</h2>
      <ul class="close-ways">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
        <li><a href={`https://instagram.com/${contact.instagram}`} rel="noopener">@{contact.instagram}</a></li>
        <li><a href="/iva-hristova-cv.pdf" download>CV (PDF)</a></li>
      </ul>
    </div>
  </section>
  <ChapterBar lang={lang} />
</Base>

<style>
  /* shared planes: every layer is the same image box, so cover-cropping keeps them registered */
  .planes { position: absolute; inset: 0; overflow: hidden; }
  .pl { position: absolute; inset: -6%; width: 112%; height: 112%; max-width: none; object-fit: cover; object-position: 38% 55%; will-change: transform; }

  /* 1 · hero */
  .hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; background: #2b1d14; }
  .sky { -webkit-mask-image: linear-gradient(#000 34%, transparent 46%); mask-image: linear-gradient(#000 34%, transparent 46%); }
  .land { -webkit-mask-image: linear-gradient(transparent 30%, #000 42%); mask-image: linear-gradient(transparent 30%, #000 42%); }
  .name { inset: auto; left: var(--pad); right: var(--pad); top: 10svh; width: auto; height: auto; margin: 0;
    font-family: var(--display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.045em; line-height: .8;
    font-size: min(10.2vw, 19svh); color: #f3ebdf; text-shadow: 0 10px 60px rgba(60, 25, 5, .35); }
  .haze { inset: 0; width: 100%; height: 100%; background:
      radial-gradient(60% 45% at 8% 22%, rgba(255, 196, 120, .38), transparent 70%),
      linear-gradient(180deg, transparent 60%, rgba(28, 20, 14, .55) 100%); mix-blend-mode: screen; pointer-events: none; }
  .hero-foot { position: absolute; left: var(--pad); right: var(--pad); bottom: clamp(18px, 4svh, 40px); display: flex; justify-content: space-between; align-items: end; gap: 20px; z-index: 3; font-size: var(--t-sm); color: #f3ebdf; text-shadow: 0 1px 14px rgba(0,0,0,.6); }
  .hero-foot p:first-child { font-family: var(--display); font-weight: 600; font-size: var(--t-lg); letter-spacing: -0.01em; }
  .hero-cap { font-size: var(--t-xs); max-width: 34ch; text-align: right; opacity: .85; }
  @media (max-width: 760px) {
    .pl { object-position: 30% 60%; }
    .name { top: 9svh; font-size: 17vw; }
    .sky { -webkit-mask-image: linear-gradient(#000 40%, transparent 50%); mask-image: linear-gradient(#000 40%, transparent 50%); }
    .land { -webkit-mask-image: linear-gradient(transparent 36%, #000 48%); mask-image: linear-gradient(transparent 36%, #000 48%); }
    .hero-foot { flex-direction: column; align-items: start; }
    .hero-cap { text-align: left; }
  }

  /* 2 · approach: static = the last frame with its caption; live = pinned scrub + doors */
  .approach { position: relative; background: #1a120c; color: #f3ebdf; }
  .ap-stage { position: relative; min-height: 100svh; overflow: hidden; display: grid; align-items: end; }
  .ap-still, .ap-still img, .ap-seq, .ap-door { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ap-still img { object-fit: cover; object-position: 56% 50%; }
  .ap-seq, .ap-door { display: none; }
  .ap-copy { position: relative; padding: 18svh var(--pad) clamp(40px, 9svh, 96px); max-width: 40rem; text-shadow: 0 2px 24px rgba(20, 10, 4, .55); }
  .ap-copy .display { font-size: var(--t-h1); }
  .ap-line { font-family: var(--serif); font-size: var(--t-lg); margin-top: 14px; }
  .ap-note { position: absolute; right: var(--pad); bottom: 16px; font-size: var(--t-xs); opacity: .7; text-shadow: 0 1px 10px rgba(0,0,0,.6); }
  :global(.approach.live) .ap-stage { height: 100svh; min-height: 0; display: block; background: var(--trav); }
  :global(.approach.live) .ap-still { opacity: 0; }
  :global(.approach.live) .ap-seq { display: block; }
  :global(.approach.live) .ap-door { display: block; background-size: cover; background-position: 56% 50%; will-change: transform; }
  :global(.approach.live) .ap-l { clip-path: inset(0 50% 0 0); }
  :global(.approach.live) .ap-r { clip-path: inset(0 0 0 50%); }
  :global(.approach.live) .ap-door::after { content: ''; position: absolute; top: 0; bottom: 0; width: 2px; background: linear-gradient(rgba(255,240,220,.0), rgba(255,240,220,.85) 30%, rgba(255,240,220,.85) 70%, rgba(255,240,220,0)); opacity: var(--edge, 0); }
  :global(.approach.live) .ap-l::after { left: calc(50% - 2px); }
  :global(.approach.live) .ap-r::after { left: 50%; }
  :global(.approach.live) .ap-copy { position: absolute; inset: auto 0 0 0; padding-top: 0; }
  :global(.approach.live) .ap-copy > * { opacity: 0; will-change: opacity, transform; }
  :global(.approach.live) .ap-line { position: absolute; left: var(--pad); bottom: clamp(40px, 9svh, 96px); margin: 0; font-size: clamp(1.6rem, 1rem + 2.4vw, 3.2rem); font-family: var(--display); font-weight: 700; letter-spacing: -0.03em; max-width: 18ch; }
  :global(.approach.live) .ap-copy .display { position: absolute; left: var(--pad); bottom: clamp(40px, 9svh, 96px); }

  /* 3 · peak */
  .peak { position: relative; background: var(--trav); color: var(--ink); }
  .peak-stage { position: relative; padding: clamp(72px, 10vw, 140px) var(--pad); display: grid; gap: 40px; }
  .peak-static { display: grid; grid-template-columns: 2fr 1fr; gap: var(--gap); align-items: end; }
  .peak-static :global(img) { width: 100%; mix-blend-mode: multiply; }
  .peak-static figcaption { font-family: var(--display); font-weight: 700; font-size: var(--t-h3); letter-spacing: -0.03em; margin-top: 12px; color: var(--ink); }
  .peak-3d, .peak-lines { display: none; }
  .peak-title { color: var(--ink); }
  .peak-title .display { font-size: var(--t-h1); }
  .peak-title .small { margin-top: 12px; }
  .peak-note { font-size: var(--t-xs); margin-top: 8px; opacity: .7; max-width: 60ch; }
  :global(.peak.live) .peak-stage { height: 100svh; padding: 0; display: block; overflow: hidden; }
  :global(.peak.live) .peak-static { display: none; }
  :global(.peak.live) .peak-3d { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(.peak.live) .peak-lines { display: block; list-style: none; padding: 0; position: absolute; left: var(--pad); top: 15svh; margin: 0; }
  :global(.peak.live) .peak-lines li { position: absolute; white-space: nowrap; font-size: clamp(2.2rem, 1rem + 4.6vw, 5.6rem); opacity: 0; }
  :global(.peak.live) .peak-title { position: absolute; left: var(--pad); right: var(--pad); bottom: clamp(20px, 5svh, 48px); opacity: 0; }
  @media (max-width: 760px) {
    .peak-static { grid-template-columns: 1fr; }
    :global(.peak.live) .peak-lines { top: 12svh; }
    :global(.peak.live) .peak-lines li { white-space: normal; width: calc(100vw - 2 * var(--pad)); font-size: 2.4rem; }
  }

  /* 3b · iva */
  .iva { position: relative; overflow: hidden; background: #120d09; color: var(--trav); }
  .iva :global(.iva-mark) { position: absolute; right: -6vw; top: 50%; width: min(78vw, 1200px); transform: translateY(-50%); opacity: .05; pointer-events: none; will-change: transform; }
  .iva-in { position: relative; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 6vw, 110px); align-items: center; padding-block: clamp(80px, 12vw, 170px); }
  .iva-photo { margin: 0; overflow: hidden; }
  .iva-photo :global(img) { width: 100%; max-width: 538px; height: auto; display: block; filter: contrast(1.04); }
  .iva-kicker { color: var(--muted); }
  .iva-copy .display { font-size: var(--t-h1); margin-top: 10px; }
  .iva-lead { font-family: var(--serif); font-size: var(--t-lg); line-height: 1.42; margin-top: 22px; max-width: 34ch; }
  .iva-body { margin-top: 16px; max-width: 52ch; color: #cbbfb0; }
  .iva-roles { list-style: none; padding: 0; margin: 28px 0; display: grid; gap: 10px; }
  .iva-roles li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 12px; padding-top: 10px; border-top: 1px solid rgba(218, 209, 197, .16); }
  .iva-roles span { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding-top: 3px; }
  @media (max-width: 760px) { .iva-in { grid-template-columns: 1fr; } .iva-photo :global(img) { max-width: 78vw; } .iva :global(.iva-mark) { width: 120vw; right: -30vw; } }

