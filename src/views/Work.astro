---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { ui } from '../data/site';
import type { Lang } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Base lang={lang} title={t.nav.work} alt={lang === 'en' ? '/mk/work/' : '/work/'} current="work">
  <section class="wrap page">
    <h1 class="display">{t.nav.work}</h1>
    <p class="lede muted">{t.workIntro}</p>
    <WorkList lang={lang} />
  </section>
</Base>
<style>
  .page { padding-top: clamp(110px, 16vh, 180px); padding-bottom: clamp(72px, 10vw, 140px); }
  .lede { margin: 20px 0 clamp(36px, 5vw, 64px); }
</style>
